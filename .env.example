# Market
SYMBOL=BTC/USDT
TIMEFRAME=5m
INITIAL_BARS=500
LOOP_BARS=200

# Risk
RISK_PER_TRADE=0.01
# Daily opening budget (shared across symbols in portfolio mode). Raised for paper evaluation; tighten for live.
MAX_TRADES_PER_DAY=2

# LLM (optional)
USE_LLM=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MIN_CONFIDENCE=0.6
LLM_TIMEOUT_SECONDS=3
# 429: global cooldown (no per-symbol retry loop). Retry-After can extend the cooldown.
LLM_COOLDOWN_AFTER_429_SECONDS=120
# Legacy (unused by current sentiment path; kept for older docs)
LLM_MAX_RETRIES_ON_429=3
LLM_BACKOFF_CAP_SECONDS=16

# Execution (Binance spot only; TRADE permission on API key for live orders)
PAPER_TRADING=true
# paper | live_canary | live_full — selects artifacts/deployment/<tier>_active.json for strategy profile pointer
# If unset, inferred: paper when PAPER_TRADING=true, else live_full
# DEPLOYMENT_TIER=paper

# Live canary only: multiply profile/env RISK_PER_TRADE; 0 = disable notional cap
# CANARY_RISK_MULTIPLIER=0.25
# CANARY_MAX_NOTIONAL_USDT=500
# Comma-separated ccxt pairs; empty = all symbols (live_canary)
# CANARY_SYMBOLS=BTC/USDT

# Closed-trade ledger + dashboard: same bps semantics as BACKTEST_* (per leg on notional)
# Live taker precedence (see tr_bot.fees): LIVE_FEE_BPS>0 flat → LIVE_FEE_TAKER_BPS>0 explicit taker
# → LIVE_FEE_USE_ALGO_TIERS → LIVE_FEE_USE_BINANCE_RETAIL_TAKER_DEFAULTS (BINANCE_PAY_FEES_WITH_BNB picks
# LIVE_FEE_BNB_TAKER_BPS vs LIVE_FEE_STANDARD_TAKER_BPS) → else 0. LIVE_FEE_MAKER_BPS is reserved (Tier 2).
LIVE_FEE_BPS=0
# LIVE_FEE_TAKER_BPS=10
# LIVE_FEE_MAKER_BPS=0
# If LIVE_FEE_BPS > 0, that value is used for all symbols (flat override).
# If LIVE_FEE_BPS is 0 and LIVE_FEE_USE_ALGO_TIERS=true, fees follow Binance Spot Algo tiers (see Binance docs).
# BINANCE_VIP5_PLUS=true forces 0 bps when tier mode is on.
LIVE_FEE_USE_ALGO_TIERS=false
# BINANCE_VIP5_PLUS=false
# Opt-in retail published takers (no effect unless LIVE_FEE_USE_BINANCE_RETAIL_TAKER_DEFAULTS=true):
# LIVE_FEE_USE_BINANCE_RETAIL_TAKER_DEFAULTS=false
# BINANCE_PAY_FEES_WITH_BNB=false
# LIVE_FEE_BNB_TAKER_BPS=7.5
# LIVE_FEE_STANDARD_TAKER_BPS=10
LIVE_SLIPPAGE_BPS=0
# market | twap — twap uses POST /sapi/v1/algo/spot/newOrderTwap (fills over time; high API weight)
EXECUTION_STYLE=market
# TWAP only: duration seconds [300, 86400]; optional limit price and min notional (below → market order)
# TWAP_DURATION_SECONDS=3600
# TWAP_LIMIT_PRICE=
# TWAP_MIN_NOTIONAL_USDT=
BINANCE_API_KEY=
BINANCE_SECRET=
# Optional: signed REST recvWindow in ms (1000–60000) for clock skew / -1021 tuning.
# BINANCE_RECV_WINDOW_MS=
# Optional: alternate Binance REST hosts (ccxt defaults: api.binance.com). API = origin only;
# SAPI defaults to {BINANCE_API_BASE_URL}/sapi/v1 unless BINANCE_SAPI_BASE_URL is set.
# BINANCE_API_BASE_URL=https://api.binance.com
# BINANCE_SAPI_BASE_URL=https://api.binance.com/sapi/v1
# Retries for 429/418/5xx/timeouts (market data + orders); defaults mirror CCXT_FETCH_*.
# BINANCE_HTTP_MAX_RETRIES=5
# BINANCE_HTTP_BASE_DELAY_S=1.0
# BINANCE_HTTP_MAX_DELAY_S=120.0
# Minimum seconds between TWAP SAPI reconcile rounds (0 = every trading poll).
# TWAP_RECONCILE_MIN_INTERVAL_S=0
# Retries for transient Binance/network errors (connection reset, etc.)
CCXT_FETCH_MAX_RETRIES=5
CCXT_FETCH_RETRY_DELAY_S=1.0

# Loop
POLL_SECONDS=300

# Circuit breaker
CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=3

# Optional: Redis / PostgreSQL (health checks + future persistence)
REDIS_URL=redis://localhost:6379/0
# Match a real Postgres, or use docker compose: `docker compose up -d db` then this URL on localhost.
# Default compose mapping is host 5433 -> container 5432 to avoid local 5432 conflicts.
DATABASE_URL=postgresql://tr_bot:tr_bot@localhost:5433/tr_bot
# Readiness policy:
# - READINESS_MODE=required  -> Postgres required for ready
# - READINESS_MODE=optional  -> Postgres reported but non-blocking
# - READINESS_MODE=auto      -> default; non-blocking in paper mode unless READINESS_REQUIRE_POSTGRES is explicitly set
READINESS_MODE=auto
# Backward-compatible explicit override when READINESS_MODE=auto.
# READINESS_REQUIRE_POSTGRES=false

# Log each no-trade decision to Postgres table decision_events (creates table on first insert).
# Requires DATABASE_URL; use scripts/sql/001_decision_events.sql for manual init. Export CSV for notebooks.
DECISION_LOG_DB_ENABLED=false

# Regime model: if file exists, load at startup (else train from INITIAL_BARS in-memory)
# Relative to ARTIFACTS_DIR (do not prefix a second "artifacts/"): regime_model.joblib
REGIME_MODEL_PATH=

# Offline training: python -m tr_bot.training
# TRAIN_SOURCES=yahoo,coinmarketcap,exchange
# `binance` is accepted as an alias for `exchange` (ccxt Binance spot).
# TRAIN_SOURCES=yahoo,coindesk,exchange
TRAIN_SOURCES=yahoo
# Relative to ARTIFACTS_DIR (not artifacts/regime_model.joblib — that would duplicate the folder)
TRAIN_OUTPUT_PATH=regime_model.joblib
TRAIN_TIMEFRAME=1d
# Yahoo Finance symbols (training does not scrape Yahoo "Crypto / Most Active" screens—you list tickers here).
# Equities/ETFs: plain tickers (SPY, QQQ, AAPL). Crypto spot: BASE-QUOTE (BTC-USD, ETH-EUR, ETH-BTC).
# FX: Yahoo style EURUSD=X, USDJPY=X (not the same pattern as crypto).
# Avoid stablecoins (USDT-USD, USDC-USD) and redundant wrapped/staking pairs if you already train on majors—they add little variance or duplicate signal.
# *-USDT is normalized to *-USD for Yahoo (Binance-style names are not Yahoo symbols).
YAHOO_TRAIN_TICKERS=SPY,QQQ,BTC-USD,ETH-USD
YAHOO_TRAIN_PERIOD=2y
# If true, abort when any listed Yahoo ticker fails to download (default: skip; logs [yahoo_symbol_skipped]).
YAHOO_TRAIN_FAIL_ON_SKIP=false
# Optional quality warnings after a successful fetch (0 disables). Low daily return std or tight price range often indicates stables or bad data.
YAHOO_TRAIN_MIN_DAILY_RETURN_STDDEV=0
YAHOO_TRAIN_MIN_CLOSE_RANGE_PCT=0
# CoinMarketCap Pro API (optional; Hobbyist+ for OHLCV historical)
# Prefer CMC_TRAIN_IDS (comma-separated numeric ids) or CMC_TRAIN_SLUGS over symbols — symbols are ambiguous.
# If only CMC_TRAIN_SYMBOLS is set, CMC_MAP_RESOLVE_SYMBOLS=true (default) resolves once via /v1/cryptocurrency/map.
CMC_API_KEY=
# CMC_TRAIN_IDS=1,1027
# CMC_TRAIN_SLUGS=bitcoin,ethereum
CMC_TRAIN_SYMBOLS=BTC,ETH
CMC_MAP_RESOLVE_SYMBOLS=true
CMC_INTERVAL=1d
# Credits scale with points returned; align with retrain cadence and TRAIN_DATASET_MAX_AGE_SECONDS — avoid maxing count every run.
CMC_COUNT=500
# Single quote currency per call (extra convert targets cost credits).
CMC_CONVERT=USD
# Global metrics snapshot (live loop + dashboard; same CMC_API_KEY). TTL >= 300s matches typical refresh cadence.
CMC_GLOBAL_METRICS_ENABLED=true
CMC_GLOBAL_METRICS_TTL_S=300
# Optional coarse regime feeds (poll >= 15m per docs; TTL floored to 900s in code)
# CMC_FEAR_GREED_ENABLED=false
# CMC_FEAR_GREED_TTL_S=900
# CMC_ALTCOIN_SEASON_ENABLED=false
# CMC_ALTCOIN_SEASON_TTL_S=900
# Training-only: merge global / fear-greed (and optional altcoin) history onto bars with merge_asof backward — not for live hot path.
# CMC_TRAIN_MACRO_MERGE_ENABLED=false
# CMC_TRAIN_MACRO_GLOBAL=true
# CMC_TRAIN_MACRO_FEAR_GREED=true
# CMC_TRAIN_MACRO_ALTCOIN=false
# CMC_TRAIN_MACRO_PARQUET_PATH=training/macro_merged.parquet
# TRAIN_REGIME_MACRO_FEATURES=false

# CoinDesk Data API (https://data-api.coindesk.com) — optional training, ticks, reference checks
# COINDESK_API_KEY=
# COINDESK_BASE_URL=https://data-api.coindesk.com
# COINDESK_AUTH_MODE=bearer
# COINDESK_ENABLED=false
# COINDESK_STORE_ENABLED=false
# Default market slug for index vs spot:
# - cadli: generic consolidated index (default paths: /index/cc/v1/latest/tick, historical days/hours/minutes).
# - ccix: CCIX index family (still index /index/cc/* — not the spot API; stricter validation when set, see COINDESK_CCIX_STRICT_VALIDATION).
# - coinbase, kraken, …: exchange spot slug — use spot tick path and spot reference endpoints unless overridden.
# COINDESK_DEFAULT_MARKET=cadli
# COINDESK_INSTRUMENTS=BTC-USD,ETH-USD
# COINDESK_LATEST_TICK_PATH=/index/cc/v1/latest/tick
# Spot ticks (exchange slug as COINDESK_DEFAULT_MARKET): COINDESK_LATEST_TICK_PATH=/spot/v1/latest/tick
# COINDESK_TICK_GROUPS=
# COINDESK_APPLY_MAPPING=true
# COINDESK_OHLCV_PATH=
# COINDESK_OHLCV_GROUPS=OHLC,VOLUME
# COINDESK_HISTORICAL_FILL=true
# COINDESK_HISTORICAL_RESPONSE_FORMAT=JSON
# COINDESK_ORDERBOOK_PATH=
# COINDESK_INSTRUMENTS_METADATA_PATH=
# COINDESK_HTTP_TIMEOUT_S=120
# COINDESK_MAX_RETRIES=5
# COINDESK_RETRY_BACKOFF_CAP_S=120
# COINDESK_RATE_LIMIT_REMAINING_THRESHOLD=5
# COINDESK_RATE_LIMIT_SLOW_DELAY_S=0.75
# COINDESK_POLL_SECONDS=10
# COINDESK_REDIS_CHANNEL=coindesk:ticks
# COINDESK_REDIS_PUBLISH=false
# COINDESK_TRAIN_LIMIT=2000
# COINDESK_TRAIN_TO_TS=
# USE_COINDESK_OHLCV_FROM_DB=false
# COINDESK_OHLCV_DB_TIMEFRAME=
# COINDESK_METRICS_ENABLED=false
# COINDESK_EXPORT_PARQUET_PATH=
# COINDESK_CCSEQ_POLL_MODE=true
# COINDESK_CCSEQ_BACKFILL_ON_GAP=false
# Reference preflight (/ready): index vs spot mapped instruments + markets metadata
# COINDESK_REFERENCE_CHECK_ENABLED follows COINDESK_ENABLED if unset
# COINDESK_REFERENCE_STRICT=false
# auto → cadli/ccix use /index/cc/*; exchange slugs use /spot/v1/markets and /spot/v1/markets/instruments
# COINDESK_REFERENCE_API_MODE=auto
# COINDESK_INDEX_STYLE_MARKETS=cadli,ccix
# COINDESK_INDEX_MARKETS_PATH=/index/cc/v2/markets
# COINDESK_MAPPED_INSTRUMENTS_PATH=/index/cc/v1/markets/instruments
# COINDESK_SPOT_MARKETS_PATH=/spot/v1/markets
# COINDESK_SPOT_INSTRUMENTS_PATH=/spot/v1/markets/instruments
# COINDESK_REFERENCE_CACHE_TTL_S=60
# COINDESK_MAPPED_INSTRUMENTS_CHUNK=25
# When market=ccix: reject spot tick/OHLCV paths and REFERENCE_API_MODE=spot (startup preflight)
# COINDESK_CCIX_STRICT_VALIDATION=true
# COINDESK_EOD_DAYS_PATH=/index/cc/v1/historical/days/eod
# Asset top list + on-chain (see docs/coindesk_asset_catalog.md)
# COINDESK_ASSET_TOP_LIST_ENABLED=false
# COINDESK_ASSET_TOP_LIST_PATH=/asset/v1/top/list
# COINDESK_ASSET_TOP_LIST_PAGE=1
# COINDESK_ASSET_TOP_LIST_PAGE_SIZE=50
# COINDESK_ASSET_TOP_LIST_SORT_BY=CIRCULATING_MKT_CAP_USD
# COINDESK_ASSET_TOP_LIST_GROUPS=
# COINDESK_ASSET_TOP_LIST_CACHE_TTL_S=30
# COINDESK_ASSET_TOP_LIST_USE_REDIS=false
# COINDESK_ASSET_TOP_LIST_WATCH_SYMBOLS=
# COINDESK_ONCHAIN_BY_ADDRESS_PATH=/onchain/v2/data/by/address
# COINDESK_ONCHAIN_CHAIN_SUMMARY_PATH=/onchain/v3/summary/by/chain
# SCHEDULER_COINDESK_ASSET_TOP_LIST_INTERVAL_SECONDS=0
# SCHEDULER_RUN_COINDESK_ASSET_TOP_LIST_ON_START=false

# CoinDesk quick toggles (see commented reference block above for full list).
COINDESK_API_KEY=
COINDESK_BASE_URL=https://data-api.coindesk.com
COINDESK_AUTH_MODE=bearer
COINDESK_ENABLED=false
COINDESK_STORE_ENABLED=false
COINDESK_DEFAULT_MARKET=cadli
COINDESK_INSTRUMENTS=BTC-USD,ETH-USD
COINDESK_LATEST_TICK_PATH=/index/cc/v1/latest/tick
COINDESK_CCSEQ_POLL_MODE=true
COINDESK_CCSEQ_BACKFILL_ON_GAP=false
# COINDESK_REFERENCE_API_MODE=auto
# COINDESK_REFERENCE_STRICT=false

# Optional: mix in live exchange candles (ccxt / Binance spot)
TRAIN_EXCHANGE_SYMBOL=
TRAIN_EXCHANGE_LIMIT=1000
# Paginated history (more than one fetch_ohlcv call). If all unset, single-call limit above is used.
# TRAIN_EXCHANGE_LOOKBACK_DAYS=365
# TRAIN_EXCHANGE_START_MS=
# TRAIN_EXCHANGE_END_MS=
TRAIN_EXCHANGE_FETCH_SLEEP_S=0.2
TRAIN_EXCHANGE_CHUNK_LIMIT=1000
# 0 = use all rows after concat. If set, keeps the last N rows in time order (not random).
TRAIN_MAX_ROWS=0

# Cached training concat (parquet) for retraining without re-downloading
# TRAIN_DATASET_PATH=training/datasets/latest.parquet
# TRAIN_DATASET_MODE=fetch_only
# fetch_only | load_or_fetch | load_only
TRAIN_DATASET_MAX_AGE_SECONDS=0
TRAIN_DATASET_VERSION_SNAPSHOT=true

# Managers (fund / portfolio / advisory / training jobs)
MANAGERS_ENABLED=true
# Bot + FastAPI dashboard must share this path for heartbeat, equity_history.json, trading_snapshot.json.
# Local: `./start.sh --all` uses one cwd so both see ./artifacts. Docker: mount the same volume on api + bot.
ARTIFACTS_DIR=artifacts
# Live trading symbols: if false (or empty weights), only SYMBOL above is traded. If true, set PORTFOLIO_WEIGHTS
# (CCXT/Binance spot pairs like BTC/USDT). YAHOO_TRAIN_TICKERS etc. are for offline training only, not the loop.
PORTFOLIO_MODE=false
# PORTFOLIO_MODE=true
# PORTFOLIO_WEIGHTS=BTC/USDT=0.5,ETH/USDT=0.3,SOL/USDT=0.2
# Fraction of peak NAV (0.25 = 25%). Compared to (peak-nav)/peak each refresh; not percent points like 25.
MAX_DRAWDOWN_PCT=0.25
PAPER_EQUITY_USDT=10000
FUND_QUOTE_ASSET=USDT
FUND_REFRESH_SECONDS=300
# TTL for Binance quote→USDT rate cache (position sizing on non-USDT pairs)
# QUOTE_USDT_CACHE_SECONDS=60
# Touch artifacts/TRADING_HALTED to stop trading (with MANAGERS_ENABLED=true)
TRADING_HALT_FILENAME=TRADING_HALTED
ADVISORY_USE_REDIS=true
ADVISORY_TTL_SECONDS=3600
ADVISORY_WORKER_IN_PROCESS=true
ADVISORY_WORKER_INTERVAL_SECONDS=900
MIN_TRAIN_ROWS_VALIDATE=500
TRAINING_PROMOTE_ON_SUCCESS=false

# Regime RandomForest (offline training; defaults match prior hardcoded model)
# TRAIN_RF_N_ESTIMATORS=100
# TRAIN_RF_RANDOM_STATE=42
# TRAIN_RF_MAX_DEPTH=8
# TRAIN_RF_MIN_SAMPLES_LEAF=1
# sqrt | log2 | auto | fraction — empty = sklearn default
# TRAIN_RF_MAX_FEATURES=

# Time-series CV (overfitting diagnostics: OOF F1, train/val gap, baselines)
TRAIN_RUN_VALIDATION=true
TRAIN_TS_SPLITS=5
TRAIN_MIN_ROWS_PER_FOLD=80
# 0 = do not enforce minimum OOF F1
TRAIN_MIN_OOF_F1=0
# 1.0 = no train/val gap cap; e.g. 0.15 caps mean fold (train_acc - val_acc)
TRAIN_MAX_TRAIN_VAL_GAP=1.0
# If true, abort training when gates fail (no new .joblib)
TRAIN_VALIDATION_STRICT=false
# If true, allow promote even when validation gates fail (dev only)
TRAIN_SKIP_VALIDATION_GATES=false
# If true, CV per (source, asset) then median metrics (multi-ticker training)
TRAIN_VALIDATION_PER_GROUP=false

# Post-train gate: walk-forward backtest using the new regime model (ccxt fetch; uses TIMEFRAME if unset)
TRAIN_BACKTEST_GATE=false
# TRAIN_BACKTEST_SYMBOL=
# 0 = use BACKTEST_BARS
TRAIN_BACKTEST_BARS=0
# TRAIN_BACKTEST_TIMEFRAME=
# When TRAIN_BACKTEST_GATE=true, optional bounds (if both unset, permissive defaults apply)
# TRAIN_BACKTEST_MIN_TOTAL_RETURN_PCT=
# TRAIN_BACKTEST_MAX_DRAWDOWN_PCT=

# Walk-forward backtest: python -m tr_bot.managers backtest-run (uses SYMBOL/TIMEFRAME)
BACKTEST_BARS=1500
BACKTEST_MAX_EQUITY_POINTS=200
# Costs (basis points per side on notional)
# BACKTEST_FEE_BPS=0
# When BACKTEST_FEE_BPS=0: BACKTEST_TAKER_BPS>0 uses that; else backtest uses effective_taker_bps(SYMBOL) (same as live).
# BACKTEST_TAKER_BPS=0
# BACKTEST_SLIPPAGE_BPS=0
# Policy parity knobs (live LLM sentiment is not replayed historically)
# BACKTEST_SENTIMENT_MODE=neutral
# always_pass | never_pass | match_engine
# BACKTEST_FUNDAMENTALS_MODE=always_pass
# BACKTEST_SKIP_TA_FILTER=false
# 0 = off; sample every Nth bar into audit_sample in JSON result
# BACKTEST_AUDIT_SAMPLE_STRIDE=0
# BACKTEST_RUN_ABLATION_MATRIX=false
# BACKTEST_INCLUDE_BUY_HOLD=true
# Backtest/live parity controls
# BACKTEST_ENFORCE_REGIME_CONFIDENCE=true
# BACKTEST_ENFORCE_SIGNAL_STRENGTH=true
# BACKTEST_ENFORCE_LOSS_COOLDOWN=true
# BACKTEST_USE_CIRCUIT_BREAKER=true
# BACKTEST_CIRCUIT_MAX_CONSECUTIVE_LOSSES=3
# Backtest execution realism (probabilistic entry outcomes)
# BACKTEST_EXECUTION_REALISM_ENABLED=false
# BACKTEST_EXECUTION_SKIP_PCT=0
# BACKTEST_EXECUTION_REJECT_PCT=0
# BACKTEST_EXECUTION_PARTIAL_FILL_MIN=1.0
# BACKTEST_EXECUTION_PARTIAL_FILL_MAX=1.0
# BACKTEST_EXECUTION_RANDOM_SEED=42
# Exchange realism checks (precision/min amount/min notional)
# BACKTEST_ENFORCE_EXCHANGE_LIMITS=false
# Exit realism model (partial/delayed/slippage-aware exits)
# BACKTEST_EXIT_REALISM_ENABLED=false
# BACKTEST_EXIT_DELAY_PROB_PCT=0
# BACKTEST_EXIT_PARTIAL_FILL_MIN=1.0
# BACKTEST_EXIT_PARTIAL_FILL_MAX=1.0
# BACKTEST_EXIT_EXTRA_SLIPPAGE_BPS=0
# If exit delay fires, fill at next bar open/close (slippage/partial; no second delay)
# BACKTEST_EXIT_DELAY_FILL_NEXT_BAR=false
# BACKTEST_EXIT_DELAY_FILL_PRICE=open
# Gaps vs nominal bar for Sharpe/Sortino annualization (inter-bar interval > nominal * multiplier)
# BACKTEST_ANNUAL_GAP_MULTIPLIER=3.0
# Risk-metric publication rule
# BACKTEST_MIN_RISK_METRIC_OBS=30

# Mean reversion RSI bands ([tr_bot/signals.py])
# SIGNAL_RSI_OVERSOLD=30
# SIGNAL_RSI_OVERBOUGHT=70
# Startup restore reconciliation (live): required base >= size * (1 - tolerance)
# RESTORE_RECONCILE_TOLERANCE_PCT=0.05
# RESTORE_RECONCILE_USE_ORDER_HISTORY=true
# RESTORE_RECONCILE_TRADES_LOOKBACK=200
# RESTORE_RECONCILE_REQUIRE_ORDER_ID=false
# Live microstructure guards (bar-level)
# USE_MICROSTRUCTURE_GUARD=false
# MICRO_MAX_BAR_RANGE_PCT=4.0
# MICRO_MAX_BAR_JUMP_PCT=2.0
# MICRO_MIN_BAR_VOLUME=0
# Optional order-book quality checks (live only)
# MICRO_USE_SPREAD_DEPTH_GUARD=false
# MICRO_MAX_SPREAD_PCT=0.5
# MICRO_MIN_TOP_DEPTH_NOTIONAL=0

# Optional: append one JSON line per N trading loops (path under ARTIFACTS_DIR if relative)
DECISION_AUDIT_JSONL_PATH=
DECISION_AUDIT_EVERY_N_LOOPS=1

# Scheduler: ./start.sh --scheduler or python -m tr_bot.scheduler (separate from trading loop)
# Set SCHEDULER_ENABLED=true or any interval > 0 to run.
SCHEDULER_ENABLED=false
SCHEDULER_TRAINING_INTERVAL_SECONDS=0
SCHEDULER_BACKTEST_INTERVAL_SECONDS=0
SCHEDULER_INITIAL_DELAY_SECONDS=60
SCHEDULER_RUN_TRAINING_ON_START=false
SCHEDULER_RUN_BACKTEST_ON_START=false
SCHEDULER_RUN_ADAPTATION_ON_START=false
SCHEDULER_TICK_SECONDS=30
# Optional: periodic strategy gate evaluation (same process as training/backtest scheduler)
# SCHEDULER_PROMOTION_INTERVAL_SECONDS=604800
# SCHEDULER_RUN_PROMOTION_ON_START=false
# No-trade adaptation (same scheduler process; does not block the trading loop)
# ADAPTATION_ENABLED=false
# ADAPTATION_INTERVAL_SECONDS=0
# SCHEDULER_RUN_ADAPTATION_ON_START=false
# Daily report: artifacts/reports/YYYY-MM-DD.json + .md (yesterday UTC when run from scheduler)
# SCHEDULER_DAILY_REPORT_INTERVAL_SECONDS=0
# SCHEDULER_RUN_DAILY_REPORT_ON_START=false
# DAILY_REPORT_MAX_TRADE_ROWS=10000
# LLM proposal allowlist (comma-separated overlay keys; empty = built-in subset). Used by proposal_validate / proposal-apply.
# LLM_PROPOSAL_PARAM_KEYS=
# ADAPTATION_MIN_LOOPS_NO_OPEN=48
# ADAPTATION_COOLDOWN_SECONDS=86400
# ADAPTATION_AUDIT_TAIL_LINES=400
# ADAPTATION_AUDIT_JSONL_PATH=
# Steps / floors (safety): REGIME_MIN_CONFIDENCE never below floor after relax
# ADAPTATION_REGIME_CONFIDENCE_STEP=0.05
# ADAPTATION_REGIME_CONFIDENCE_FLOOR=0.35
# ADAPTATION_RSI_DISTANCE_STEP=0.5
# ADAPTATION_RSI_DISTANCE_FLOOR=0
# ADAPTATION_ADX_MARGIN_STEP=0.5
# ADAPTATION_ADX_MARGIN_FLOOR=0
# ADAPTATION_RSI_BAND_STEP=1
# ADAPTATION_RSI_OVERSOLD_CEILING=45
# ADAPTATION_RSI_OVERBOUGHT_FLOOR=55
# ADAPTATION_RELAX_RSI_ON_WEAK_SIGNAL=false
# ADAPTATION_ENABLE_TREND_ON_HOLD=false
# Paper: auto-write profile + paper pointer when gate passes; live tiers: proposals only unless you enable paper apply
# ADAPTATION_AUTO_APPLY_PAPER=true
# ADAPTATION_BACKTEST_TIMEOUT_SECONDS=300
# Gate thresholds (fallback: STARTUP_BACKTEST_* when unset)
# ADAPT_BACKTEST_MIN_RETURN_PCT=
# ADAPT_BACKTEST_MAX_DD_PCT=
# ADAPT_BACKTEST_MIN_TRADES=

# Strategy promotion gates (strategy-evaluate / strategy-promote CLI)
# PROMOTION_MIN_TRADES=20
# PROMOTION_MIN_CALENDAR_DAYS=5
# PROMOTION_MAX_EQUITY_DRAWDOWN_PCT=0.25
# PROMOTION_MIN_PROFIT_FACTOR=
# PROMOTION_COOLDOWN_HOURS=168
# PROMOTION_FROZEN=false
# PROMOTION_BREAK_COOLDOWN=false

# Optional: one rollup file per UTC day under artifacts/strategy_rollups/
# STRATEGY_DAILY_ROLLUP_ENABLED=false

# Extended TA (MACD, BB, ADX, Stochastic, volume z-score) + optional filters
USE_EXTENDED_TA=true
USE_TA_FILTER=false
# Mean reversion: skip when ADX above this. Trend continuation: require ADX at least ADX_MIN_FOR_TREND when TREND_STRATEGY_ENABLED=true
# ADX_MAX_FOR_MEAN_REVERSION=35
# ADX_MIN_FOR_TREND=22
# TREND_STRATEGY_ENABLED=false
ADX_MAX_FOR_MEAN_REVERSION=40

# Live loop: regime confidence + signal-strength gates (defaults match config.py)
REGIME_MIN_CONFIDENCE=0.55
USE_SIGNAL_STRENGTH_FILTER=true
SIGNAL_MIN_RSI_DISTANCE=3
SIGNAL_MIN_ADX_MARGIN=2
# LOSS_COOLDOWN_BARS=4
# SKIP_TA_FILTER=false
# (Stock config: USE_TA_FILTER for live; BACKTEST_SKIP_TA_FILTER for backtests.)

# Fundamentals (CoinGecko crypto + yfinance equities); off by default
USE_FUNDAMENTALS_FILTER=false
FUNDAMENTALS_USE_REDIS=true
FUNDAMENTALS_CACHE_TTL_SECONDS=86400
FUNDAMENTALS_HTTP_TIMEOUT=10
COINGECKO_IDS=BTC=bitcoin,ETH=ethereum
EARNINGS_BLOCK_SECONDS=86400
MAX_CRYPTO_MARKET_CAP_RANK=500

# Notifications (structured log + optional Slack-style webhook)
NOTIFY_ENABLED=true
# NOTIFY_CHANNELS=console,webhook
# NOTIFY_WEBHOOK_URL must be a full http(s) URL when webhook is enabled (never use the word "console" here).
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
NOTIFY_WEBHOOK_FORMAT=slack
NOTIFY_WEBHOOK_TIMEOUT=10
NOTIFY_MIN_INTERVAL_SECONDS=30
# Separate throttle for Redis/PG degradation alerts (trading loop)
NOTIFY_DEPS_INTERVAL_SECONDS=300
NOTIFY_ENVIRONMENT=development
# Webhook body: slack | json | ntfy (ntfy.sh — install app, subscribe to topic URL for phone push)
# NOTIFY_WEBHOOK_FORMAT=ntfy
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-topic

# Dashboard: external URL shown in banner (optional)
# PUBLIC_BASE_URL=https://bot.example.com

# Ops / equity history (artifacts/*.json written by the trading process)
# HEARTBEAT_STALE_POLL_MULTIPLIER=3
# MAX_EQUITY_HISTORY_POINTS=288

# Dashboard API (optional; if set, use Bearer or X-Dashboard-Token on /api/dashboard/*)
# DASHBOARD_TOKEN=
# Startup automation for ./start.sh --all (hard-block by default)
# STARTUP_AUTOMATION_ENABLED=true
# STARTUP_HARD_BLOCK=true
# STARTUP_RUN_TUNING=true
# STARTUP_TUNING_LIMIT=8
# STARTUP_TUNING_TIMEOUT_SECONDS=3600
# Optional: fewer stability reruns after the grid (sweep script default is 5)
# STARTUP_TUNING_STABILITY_TOP=2
# If sweep hits timeout, continue to backtest instead of blocking startup
# STARTUP_TUNING_TIMEOUT_SOFT_FAIL=false
# Defaults (if unset): -1% min return, 12% max DD, 0 min trades — see tr_bot/startup/backtest_gate_thresholds.py
STARTUP_BACKTEST_MIN_RETURN_PCT=-1
# STARTUP_BACKTEST_MAX_DD_PCT=12
# STARTUP_BACKTEST_MIN_TRADES=0
# Training-quality gate at startup
# STARTUP_REQUIRE_VALIDATION_GATES=true
# STARTUP_MIN_OOF_F1=0
# STARTUP_MAX_TRAIN_VAL_GAP=1.0
# STARTUP_LAUNCH_SCHEDULER=true

# Local ./start.sh --api: bind (defaults shown; override when sourcing env)
# API_HOST=0.0.0.0
# API_PORT=8080
ADX_MIN_FOR_TREND=20
BACKTEST_ENFORCE_MAX_TRADES_PER_DAY=true
BACKTEST_RUN_ABLATION_MATRIX=false
BACKTEST_SENTIMENT_MODE=bullish
BACKTEST_SKIP_TA_FILTER=true
SIGNAL_RSI_OVERBOUGHT=70
SIGNAL_RSI_OVERSOLD=25
TREND_STRATEGY_ENABLED=false

# No-trade adaptation (scheduler process; set ADAPTATION_INTERVAL_SECONDS>0 when ADAPTATION_ENABLED=true)
ADAPTATION_ENABLED=false
ADAPTATION_INTERVAL_SECONDS=0
ADAPTATION_MIN_LOOPS_NO_OPEN=48
ADAPTATION_COOLDOWN_SECONDS=86400
ADAPTATION_AUDIT_TAIL_LINES=400
ADAPTATION_AUDIT_JSONL_PATH=
ADAPTATION_REGIME_CONFIDENCE_STEP=0.05
ADAPTATION_REGIME_CONFIDENCE_FLOOR=0.35
ADAPTATION_RSI_DISTANCE_STEP=0.5
ADAPTATION_RSI_DISTANCE_FLOOR=0.0
ADAPTATION_ADX_MARGIN_STEP=0.5
ADAPTATION_ADX_MARGIN_FLOOR=0.0

# =============================================================================
# Appendix: optional variables often enabled in local .env (all commented here)
# Copy lines into your .env as needed. Duplicates earlier sections are pointers
# for templates that group vars like a production checklist.
# =============================================================================
#
# Readiness (see DATABASE_URL block for semantics)
# READINESS_MODE=auto
# READINESS_REQUIRE_POSTGRES=false
#
# Startup pipeline (./start.sh --all) — full list also under "Startup automation" above
# STARTUP_TUNING_TIMEOUT_SECONDS=3600
# STARTUP_TUNING_LIMIT=8
# STARTUP_TUNING_STABILITY_TOP=2
# STARTUP_TUNING_TIMEOUT_SOFT_FAIL=false
#
# Regime model file under ARTIFACTS_DIR (when set, loaded at startup)
# REGIME_MODEL_PATH=regime_model.joblib
#
# Multi-symbol portfolio weights (requires PORTFOLIO_MODE=true)
# PORTFOLIO_WEIGHTS=BTC/USDT=0.5,ETH/USDT=0.3,SOL/USDT=0.2
#
# Training dataset cache (see TRAIN_DATASET_* above)
# TRAIN_DATASET_PATH=training/datasets/latest.parquet
# TRAIN_DATASET_MODE=load_or_fetch
#
# RandomForest overrides (see TRAIN_RF_* under offline training)
# TRAIN_RF_N_ESTIMATORS=100
# TRAIN_RF_MAX_DEPTH=8
# TRAIN_RF_MIN_SAMPLES_LEAF=1
#
# Post-train backtest gate (see TRAIN_BACKTEST_* above)
# TRAIN_BACKTEST_GATE=false
# TRAIN_BACKTEST_SYMBOL=
# TRAIN_BACKTEST_BARS=0
# TRAIN_BACKTEST_TIMEFRAME=
# TRAIN_BACKTEST_MIN_TOTAL_RETURN_PCT=
# TRAIN_BACKTEST_MAX_DRAWDOWN_PCT=
#
# Backtest CLI: fees, slippage, fundamentals mode, audit stride, buy&hold baseline
# BACKTEST_FEE_BPS=0
# BACKTEST_SLIPPAGE_BPS=0
# BACKTEST_FUNDAMENTALS_MODE=always_pass
# BACKTEST_AUDIT_SAMPLE_STRIDE=0
# BACKTEST_INCLUDE_BUY_HOLD=true
#
# Optional JSONL decision audit (path relative to ARTIFACTS_DIR if not absolute)
# DECISION_AUDIT_JSONL_PATH=
# DECISION_AUDIT_EVERY_N_LOOPS=1
#
# Notifications: channel list + webhook (empty URL disables webhook)
# NOTIFY_CHANNELS=console
# NOTIFY_WEBHOOK_URL=
#
# Dashboard banner URL + heartbeat / equity JSON caps
# PUBLIC_BASE_URL=
# HEARTBEAT_STALE_POLL_MULTIPLIER=3
# MAX_EQUITY_HISTORY_POINTS=288
#
# Background scheduler (see SCHEDULER_* section above)
# SCHEDULER_ENABLED=false
# SCHEDULER_TRAINING_INTERVAL_SECONDS=0
# SCHEDULER_BACKTEST_INTERVAL_SECONDS=0
# SCHEDULER_INITIAL_DELAY_SECONDS=60
# SCHEDULER_RUN_TRAINING_ON_START=false
# SCHEDULER_RUN_BACKTEST_ON_START=false
# SCHEDULER_RUN_ADAPTATION_ON_START=false
# SCHEDULER_TICK_SECONDS=30
#
# Late-override live-loop gates (duplicate at end of .env if you want these to win over earlier assignments)
# REGIME_MIN_CONFIDENCE=0.48
# SIGNAL_MIN_ADX_MARGIN=1.0
# SIGNAL_MIN_RSI_DISTANCE=1.8
