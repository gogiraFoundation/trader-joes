# =============================================================================
# TR_BOT - HARDENED PRODUCTION CONFIG (Paper Trading)
# Applied: 2026-07-16
# Changes: Fixed fees, slippage, promotion gates, backtest parity, killed sweeps.
# Docs: README.md · docs/operations.md · docs/cli.md · skills.md (code invariants)
# This file is the authoritative list of knobs; do not invent a parallel settings object.
# =============================================================================

# ---------- MARKET ----------
# Fee/R soak: use 1h (align TRAIN_TIMEFRAME). 5m often makes ATR ≈ round-trip fees.
SYMBOL=ETH/USDT
TIMEFRAME=1h
INITIAL_BARS=500
LOOP_BARS=200

# ---------- RISK ----------
RISK_PER_TRADE=0.01
MAX_TRADES_PER_DAY=2
# Max concurrent strategy opens across the portfolio. 0 = unlimited. Soak: 1.
MAX_OPEN_POSITIONS=1

# ---------- EXECUTION (Paper) ----------
PAPER_TRADING=true
EXECUTION_STYLE=market
EXIT_POLICY=software_polled
# exchange_native is rejected at runtime until protective_reconcile is wired.
BINANCE_API_KEY=
BINANCE_SECRET=

# Live safety (required when PAPER_TRADING=false / DEPLOYMENT_TIER=live_*)
# LIVE_MAX_NOTIONAL_USDT=50
# LIVE_BALANCE_RESERVE_BPS=20
# EXIT_WATCHDOG_INTERVAL_S=5
# DEPLOYMENT_TIER=paper
# CANARY_RISK_MULTIPLIER=0.25
# CANARY_MAX_NOTIONAL_USDT=50
# CANARY_SYMBOLS=BTC/USDT

# =============================================================================
# FEES (see tr_bot/fees.py). LIVE_FEE_BPS > 0 is a flat override for ALL symbols
# and blocks the BNB retail path. Fee/R soak: clear flat override and use retail.
#   LIVE_FEE_BPS=0
#   LIVE_FEE_USE_BINANCE_RETAIL_TAKER_DEFAULTS=true
#   BINANCE_PAY_FEES_WITH_BNB=true   → LIVE_FEE_BNB_TAKER_BPS (7.5)
# Exchange account must also pay fees with BNB; env only models the rate.
# =============================================================================
LIVE_FEE_BPS=0
LIVE_SLIPPAGE_BPS=3
BACKTEST_FEE_BPS=0
BACKTEST_SLIPPAGE_BPS=3
LIVE_FEE_USE_ALGO_TIERS=false
LIVE_FEE_USE_BINANCE_RETAIL_TAKER_DEFAULTS=true
BINANCE_PAY_FEES_WITH_BNB=true
LIVE_FEE_BNB_TAKER_BPS=7.5
LIVE_FEE_STANDARD_TAKER_BPS=10.0

# Skip entries when ATR/close < this (fee/R). ~3× RT at 7.5 bps ≈ 0.0045.
# Without BNB (10 bps RT=0.002) use ~0.006. 0 = disabled.
MIN_ATR_PCT=0.0045
# Cap paper notional (USDT); 0 = disabled. Keeps fee drag bounded vs RISK_PER_TRADE.
PAPER_MAX_NOTIONAL_USDT=8000

# ---------- LOOP & CIRCUIT ----------
POLL_SECONDS=300
CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=3

# ---------- LLM (sentiment veto + agents) ----------
# Sentiment is advisory only (never opens trades). For xAI Grok:
#   USE_LLM=true
#   OPENAI_BASE_URL=https://api.x.ai/v1
#   OPENAI_API_KEY=<xai_key>
#   LLM_MODEL=grok-2-latest
USE_LLM=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MIN_CONFIDENCE=0.6
LLM_TIMEOUT_SECONDS=3

# Supervisor + Fund Manager agents (scheduler job / python -m tr_bot.managers agents-run)
# Default dry-run: briefs only. Auto-mutate flags stay false until soaked.
AGENTS_ENABLED=false
AGENTS_DRY_RUN=true
AGENTS_MIN_CONFIDENCE=0.7
AGENTS_COOLDOWN_SECONDS=3600
AGENTS_AUTO_PAUSE=false
AGENTS_AUTO_RESUME=false
AGENTS_AUTO_RESET_CIRCUIT=false
AGENTS_AUTO_EMIT_PROPOSAL=false
AGENTS_AUTO_APPLY_PROPOSAL=false
AGENTS_AUTO_REBALANCE_SCAN=false
AGENTS_HALT_REASON=agents_supervisor_pause
# Empty AGENTS_MODEL → LLM_MODEL (e.g. grok-2-latest when using xAI)
AGENTS_MODEL=
AGENTS_TIMEOUT_SECONDS=30
SCHEDULER_AGENTS_INTERVAL_SECONDS=0
SCHEDULER_RUN_AGENTS_ON_START=false

# ---------- DATABASE / REDIS ----------
# Local ./start.sh defaults (host ports). Homelab docker-compose overrides
# REDIS_URL and DATABASE_URL to redis://redis:6379/0 and db:5432.
# Optional Compose vars: POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# (password default tr_bot).
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://tr_bot:tr_bot@localhost:5435/tr_bot
# POSTGRES_PASSWORD=tr_bot
READINESS_MODE=auto

# ---------- SCHEDULER (Match running process) ----------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULER_TRAINING_INTERVAL_SECONDS=43200   # Keep for regime retraining
SCHEDULER_BACKTEST_INTERVAL_SECONDS=21600
SCHEDULER_INITIAL_DELAY_SECONDS=60
SCHEDULER_RUN_TRAINING_ON_START=false
SCHEDULER_RUN_BACKTEST_ON_START=false

# =============================================================================
# CRITICAL FIX: KILL THE AUTO-SWEEP (Prevents profile hopping)
# We set limit to 0 so startup pipeline does NOT generate new sweep_* profiles.
# Re-enable (e.g., 8) ONLY after engine.py code fixes are deployed.
# =============================================================================
STARTUP_TUNING_LIMIT=0
STARTUP_TUNING_TIMEOUT_SECONDS=3600
STARTUP_TUNING_STABILITY_TOP=2
STARTUP_TUNING_TIMEOUT_SOFT_FAIL=false

# ---------- BACKTEST GATES (Hardened) ----------
# Deep history: BACKTEST_BARS > ~1000 uses paginated ccxt fetch for exchange pairs
BACKTEST_BARS=30000
BACKTEST_MAX_EQUITY_POINTS=200
BACKTEST_ENFORCE_MAX_TRADES_PER_DAY=true
BACKTEST_RUN_ABLATION_MATRIX=false

# =============================================================================
# CRITICAL FIX: BACKTEST HONESTY (Remove handicaps, enforce parity)
# =============================================================================
BACKTEST_SENTIMENT_MODE=neutral          # Was 'bullish' -> inflated returns
BACKTEST_SKIP_TA_FILTER=false            # Match live loop friction
BACKTEST_INCLUDE_BUY_HOLD=true

# ---------- STARTUP / PROMOTION GATES (Critical Fixes) ----------
# ./start.sh --all: STARTUP_AUTOMATION_ENABLED=true (shell default) runs the pipeline.
# STARTUP_AUTOMATION_ENABLED=true
# STARTUP_HARD_BLOCK=true
# STARTUP_LAUNCH_SCHEDULER=true
# STARTUP_RUN_TUNING=true
# Prevents zero-trade backtests from activating a profile.
# Code default min trades is 3 (tr_bot/startup/backtest_gate_thresholds.py); soak uses 20.
STARTUP_BACKTEST_MIN_RETURN_PCT=-1
STARTUP_BACKTEST_MAX_DD_PCT=12
STARTUP_BACKTEST_MIN_TRADES=20

# Promotion to live: exact profile attribution + statistical floors
PROMOTION_REQUIRE_COMPARATOR=true
PROMOTION_MIN_TRADES=50
PROMOTION_MIN_CALENDAR_DAYS=14
PROMOTION_MAX_EQUITY_DRAWDOWN_PCT=0.25
PROMOTION_MIN_PROFIT_FACTOR=1.15
PROMOTION_STRICT_LEDGER_FILTER=true
PROMOTION_COOLDOWN_HOURS=168
PROMOTION_FROZEN=false

# ---------- REGIME & SIGNAL (Tightened) ----------
REGIME_MIN_CONFIDENCE=0.65               # Was 0.55 -> reduced flapping
USE_SIGNAL_STRENGTH_FILTER=true
SIGNAL_MIN_RSI_DISTANCE=3
SIGNAL_MIN_ADX_MARGIN=2

# ---------- STRATEGY ENGINE (Locked to ATR until code fix) ----------
STRATEGY_ENGINE=legacy
EXIT_MODE=atr                            # Enforced; sweep overrides disabled by LIMIT=0
SMC_MIN_TRADE_SCORE=65
SMC_MIN_SMC_FACTORS=2
SMC_HTF_TIMEFRAME=4h
SMC_PRIMARY_TIMEFRAME=1h
SMC_ENTRY_TIMEFRAME=15m
SMC_EXEC_TIMEFRAME=5m

# ---------- MEAN REVERSION PARAMETERS (Your original setup) ----------
USE_EXTENDED_TA=true
USE_TA_FILTER=false
TREND_STRATEGY_ENABLED=false             # Force range/mean-reversion until fixed
ADX_MAX_FOR_MEAN_REVERSION=40
ADX_MIN_FOR_TREND=20
SIGNAL_RSI_OVERSOLD=25
SIGNAL_RSI_OVERBOUGHT=70

# ---------- TRAINING (Regime only; align with live TIMEFRAME) ----------
# Fee/R soak: TRAIN_TIMEFRAME must match TIMEFRAME (both 1h). Retrain after TF change.
# TRAIN_EXCHANGE_LIMIT alone does NOT paginate — set TRAIN_EXCHANGE_LOOKBACK_DAYS > 0.
MANAGERS_ENABLED=true
ARTIFACTS_DIR=artifacts
PAPER_EQUITY_USDT=10000
FUND_QUOTE_ASSET=USDT

# Portfolio rebalancer (Product 1: monitor + trim-only; no withdraw)
REBALANCER_ENABLED=false
REBALANCER_EXECUTE_TRIMS=false
REBALANCE_BAND_PCT=0.05
LAG_LOOKBACK_DAYS=7
LAG_RELATIVE_RETURN_THRESHOLD=-0.08
LAG_CORR_BREAKDOWN_MAX=0.40
LAG_REQUIRE_MDD_DIVERGENCE=true
REBALANCE_BENCHMARK=EQUAL_WEIGHT_PEERS
REBALANCE_COOLDOWN_HOURS=24
REBALANCE_MAX_TRIM_USDT=0
REBALANCE_HALT_REASON=rebalancer_active

TRAIN_SOURCES=exchange
TRAIN_TIMEFRAME=1h
# Bake-off candidates; drop BNB from live weights until compare_fee_r_universes.py picks a duo.
TRAIN_EXCHANGE_SYMBOL=ETH/USDT,BTC/USDT,SOL/USDT
TRAIN_EXCHANGE_LOOKBACK_DAYS=110
TRAIN_EXCHANGE_FETCH_SLEEP_S=0.2
TRAIN_EXCHANGE_CHUNK_LIMIT=1000
TRAIN_EXCHANGE_FAIL_ON_SKIP=false
TRAIN_PRIMARY_ASSET=ETH/USDT
TRAIN_PRIMARY_SAMPLE_WEIGHT=3.0
TRAIN_DATASET_MODE=fetch_only
TRAIN_DATASET_MAX_AGE_SECONDS=0
TRAIN_OUTPUT_PATH=regime_model.joblib
MIN_TRAIN_ROWS_VALIDATE=500
# Standalone train-run gate (./start.sh --all disables this and uses backtest-run)
TRAIN_BACKTEST_GATE=true
TRAIN_BACKTEST_SYMBOL=ETH/USDT
TRAIN_BACKTEST_TIMEFRAME=1h
TRAIN_BACKTEST_BARS=3000
# Yahoo unused when TRAIN_SOURCES=exchange (do not duplicate exchange bases as *-USD)
YAHOO_TRAIN_TICKERS=SPY,QQQ
YAHOO_TRAIN_PERIOD=2y
TRAIN_VALIDATION_PER_GROUP=true
# TRAIN_MAX_ROWS is a global timestamp tail across all assets — leave 0 for multi-pair
TRAIN_MAX_ROWS=0

# Live book: set final duo after python scripts/compare_fee_r_universes.py (PF after costs).
PORTFOLIO_MODE=true
PORTFOLIO_WEIGHTS=ETH/USDT=0.5,SOL/USDT=0.5
COINGECKO_IDS=BTC=bitcoin,ETH=ethereum,SOL=solana
# ---------- NOTIFICATIONS ----------
NOTIFY_ENABLED=true
NOTIFY_ENVIRONMENT=development
NOTIFY_MIN_INTERVAL_SECONDS=30

# ---------- DASHBOARD ----------
API_HOST=0.0.0.0
API_PORT=8080
# Homelab Compose host bind for published port (default 0.0.0.0 = all interfaces).
# Use 127.0.0.1 only if nothing off-box (e.g. Pi nginx) needs to reach the API.
# API_PUBLISH=0.0.0.0
# LAN via Pi-hole + nginx: http://trbot.lan (see docs/operations.md Homelab + deploy/pi/)
PUBLIC_BASE_URL=http://trbot.lan
# Set a long token before exposing the dashboard on the LAN (Bearer / X-Dashboard-Token).
# DASHBOARD_TOKEN=
# Writes (pause/resume/circuit/promote/jobs) are OFF until both opt-in + a write-capable token.
# DASHBOARD_WRITES_ENABLED=false
# DASHBOARD_WRITE_TOKEN=
# Rolling NAV samples for Metrics / Main charts (default ≈ 7 days at POLL_SECONDS=300)
MAX_EQUITY_HISTORY_POINTS=2016
# DASHBOARD_UI=v1|v2|v3 — newer serves index.vN.html / metrics.vN.html when present
# (fallback chain v3→v2→v1). v3 = Operator Command Console (rail + KPI strip).
# DASHBOARD_UI=v1

# ---------- OPTIONAL (defaults in tr_bot/config.py; uncomment to override) ----------
# DEPLOYMENT_TIER=paper
# MAX_DRAWDOWN_PCT=0.15
# EXIT_WATCHDOG_INTERVAL_S=5
# LIVE_MAX_NOTIONAL_USDT=50
# DECISION_LOG_DB_ENABLED=false
# ADAPTATION_ENABLED=false
# ADAPTATION_INTERVAL_SECONDS=0
# ADAPTATION_AUTO_APPLY_PAPER=true
# CMC_API_KEY=
# COINDESK_ENABLED=false
# COINDESK_API_KEY=
# TRAIN_RUN_VALIDATION=true
# TRAIN_VALIDATION_STRICT=true
# TRAIN_MIN_OOF_F1=0.55
# Full knob catalog: skills.md + tr_bot/config.py (do not invent a parallel settings object).